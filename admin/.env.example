# Copy this file to .env and fill in real values before running.
# Never commit the real .env file to git.

# PostgreSQL connection
DATABASE_URL=postgres://tripreviewall_user:CHANGE_ME@localhost:5432/tripreviewall

# Server
PORT=4000
NODE_ENV=development

# Session cookie
SESSION_COOKIE_NAME=trv_admin_session
# How long a session stays valid, in hours
SESSION_TTL_HOURS=12

# Used only once, to create the very first admin account via `npm run migrate -- --seed-admin`
SEED_ADMIN_EMAIL=you@tripreviewall.com
SEED_ADMIN_PASSWORD=change-this-before-seeding
SEED_ADMIN_NAME=Admin

# Absolute path to the public frontend site root (the folder containing
# index.html, tours.html, css/, js/, tours/, blog/, etc). Used to write
# server-generated static HTML pages directly into tours/<slug>.html and
# blog/<slug>.html so search engines get real content on first load.
# On the VPS this is the sibling folder of "admin/" — e.g. /home/deploy/tripreviewall
SITE_ROOT=/home/deploy/tripreviewall
SITE_URL=https://tripreviewall.com
